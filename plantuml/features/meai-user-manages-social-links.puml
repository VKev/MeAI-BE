@startuml
title User Reviews, Refreshes And Disconnects Social Links
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Frontend Social Links Component" {
class "SocialLinks Screen" as FE1 <<Frontend>> {
  +isDisconnectOpen: boolean
  +connectingPlatform: string | null
  +expandedPlatforms: Set<string>
  +togglePlatform(platformKey: string)
  +handleConnect(platform: PlatformConfig)
  +openDisconnectModal(platform, account)
  +handleDisconnect()
}
class "Social Media Client APIs" as FE2 <<Frontend>> {
  +fetchSocialMedias()
  +deleteSocialMedia(id: string)
  +getThreadsAuthUrl()
  +getTikTokAuthUrl()
  +getFacebookAuthUrl()
  +getInstagramAuthUrl()
}
class "Query Invalidation Hook" as FE3 <<Frontend>> {
  +invalidateQueries(queryKey)
}
}

package "Backend Social Services" {
class "Social Media Controller" as BE1 <<Backend>> {
  +fetchSocialMedias()
  +deleteSocialMedia(id: string)
}
class "Platform Auth Gateway" as BE2 <<Backend>> {
  +getThreadsAuthUrl()
  +getTikTokAuthUrl()
  +getFacebookAuthUrl()
  +getInstagramAuthUrl()
}
}

package "Database And Platform Integrations" {
class "Social Connection Store" as INT1 <<Integration>> {
  +socialMediaAccounts: Table
}
class "Platform OAuth Providers" as INT2 <<Integration>> {
  +Meta OAuth Flow
  +TikTok OAuth Flow
  +Threads OAuth Flow
}
}

FE1 --> FE2
FE1 --> FE3
FE2 --> BE1
FE2 --> BE2
BE1 --> INT1
BE2 --> INT2
@enduml

@startuml
title User Reviews, Refreshes And Disconnects Social Links
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor User
box "Frontend Social Links" #E8F0FE
participant "Visible Layout" as Screen
participant "Social Media Clients" as Hook
participant "React Query Cache" as Store
end box

box "Gateway And Backend" #FFF4E5
participant "API Gateway" as Gateway
participant "SocialMedia Controller" as SocialSvc
participant "Auth URL Generator" as AuthUrlSvc
end box

box "External Systems & DB" #E8F5E9
participant "OAuth Provider" as OAuth
participant "Database" as DB
end box

group Hydration & Workspace List Sync
  User -> Screen : open Social Links screen
  Screen -> Gateway : GET /api/User/social-medias
  Gateway -> SocialSvc : list connected social accounts
  SocialSvc -> DB : read socialMediaAccounts table
  DB --> SocialSvc : accounts data
  SocialSvc --> Gateway : accounts payload (pageName, pageProfilePictureUrl, type, profile)
  Gateway --> Screen : accounts list
  Screen -> Screen : group accounts by platform type (facebook, instagram, tiktok, threads)
  Screen --> User : render platforms list showing counts of active connections
  
  opt User clicks "Sync Now" button
    User -> Screen : click Sync Now
    Screen -> Gateway : GET /api/User/social-medias
    Gateway -> SocialSvc : fetch fresh accounts rows
    SocialSvc --> Gateway : refreshed accounts list
    Gateway --> Screen : payload
    Screen -> Store : invalidate queries & update visible balance/cards
  end
end

group Connect Account via Platform OAuth Redirect
  User -> Screen : click "Connect" or "Add Another" button under a platform card
  Screen -> Screen : set connectingPlatform state to block duplicate clicks
  
  alt Platform is Facebook
    Screen -> Gateway : GET /api/User/social-medias/facebook/auth-url (getFacebookAuthUrl)
  else Platform is Instagram
    Screen -> Gateway : GET /api/User/social-medias/instagram/auth-url (getInstagramAuthUrl)
  else Platform is TikTok
    Screen -> Gateway : GET /api/User/social-medias/tiktok/auth-url (getTikTokAuthUrl)
  else Platform is Threads
    Screen -> Gateway : GET /api/User/social-medias/threads/auth-url (getThreadsAuthUrl)
  end
  
  Gateway -> AuthUrlSvc : generate authorization redirection URL
  AuthUrlSvc --> Gateway : response (authorizationUrl)
  Gateway --> Screen : authorizationUrl payload
  
  Screen -> OAuth : redirect browser to window.location.href = authorizationUrl
  OAuth --> User : prompt OAuth Permission Scopes dialog (facebook/tiktok/threads login)
  User -> OAuth : grant permissions
  OAuth --> Screen : callback handles authentication, saves token to database & redirects back to Social Links route
  Screen -> Store : invalidate social-medias queries to refresh list
  Screen -> Screen : set connectingPlatform = null
end

group Group Facebook Accounts & Disconnect Operations
  opt Group Facebook page unlink
    Screen -> Screen : group Facebook pages sharing the same profile.userId (Facebook login session)
    Screen --> User : display collective user info box with list of associated pages
    User -> Screen : click "Unlink account" button on the collective Facebook box
    Screen --> User : prompt window.confirm ("Disconnect Facebook account? This removes all linked pages.")
    User -> Screen : confirm unlink
    loop For each page in the Facebook group
      Screen -> Gateway : DELETE /api/User/social-medias/{pageId}
      Gateway -> SocialSvc : deleteSocialMedia(id)
      SocialSvc -> DB : delete socialMediaAccount association, clean active workspace link mappings
      DB --> SocialSvc : deleted
      SocialSvc --> Gateway : success
      Gateway --> Screen : page unlinked successfully
    end
    Screen -> Store : invalidate queries (social-medias, social-medias-publish, dashboard-social-medias, posts)
  end

  group Individual Account Unlink
    User -> Screen : click delete trash can icon on an individual account card
    Screen -> Screen : set selectedPlatform & selectedAccount values
    Screen --> User : prompt Disconnect Confirmation Modal
    User -> Screen : click "Disconnect" button
    Screen -> Gateway : DELETE /api/User/social-medias/{accountId}
    Gateway -> SocialSvc : deleteSocialMedia(id)
    SocialSvc -> DB : delete account row and clear dependencies
    alt subscription limits or guard rules block action
      DB --> SocialSvc : block unlink
      SocialSvc --> Gateway : 400 Bad Request
      Gateway --> Screen : error payload (Subscription.Required)
      Screen --> User : show error toast ("An active subscription is required.")
    else account detached
      DB --> SocialSvc : deleted success
      SocialSvc --> Gateway : success response
      Gateway --> Screen : unlink confirmed
      Screen -> Store : invalidate queries to trigger global queries cache refetch
      Screen -> Screen : close modal, show success toast
    end
  end
end
@endl
