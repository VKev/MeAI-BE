@startuml
title User Updates Profile Fields, Avatar And Password
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Frontend Profile Management" {
class "UserSettings Screen" as FE1 <<Frontend>> {
  +hasChanges: boolean
  +showOldPassword: boolean
  +showNewPassword: boolean
  +showConfirmNewPassword: boolean
  +fileInputRef: Ref
  +onSubmitUpdateProfile()
  +handleOnChange(e: ChangeEvent)
  +onSubmitChangePassword()
}
class "Profile Update Schema & Hooks" as FE2 <<Frontend>> {
  +UpdateProfileFormSchema
  +ChangePasswordFormSchema
  +updateMutation()
  +uploadAvatarMutation()
  +changePasswordMutation()
}
class "User Store & Refetch" as FE3 <<Frontend>> {
  +userCoins: number
  +refetchUser()
}
}

package "Backend Services" {
class "User Profile Controller" as BE1 <<Backend>> {
  +getMe()
  +updateProfile(payload: TUpdateProfilePayload)
  +uploadAvatar(file: File)
}
class "User Auth Controller" as BE2 <<Backend>> {
  +changePassword(payload: TChangePasswordPayload)
}
}

package "External Storage & Database" {
class "S3 & Presigned Avatar Storage" as INT1 <<Integration>> {
  +avatarPresignedUrl
}
class "User Database" as INT2 <<Integration>> {
  +users: Table
}
}

FE1 --> FE2
FE1 --> FE3
FE2 --> BE1
FE2 --> BE2
BE1 --> INT1
BE1 --> INT2
BE2 --> INT2
@enduml

@startuml
title User Updates Profile Fields, Avatar And Password
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor User
box "Frontend Settings" #E8F0FE
participant "Visible Settings" as Screen
participant "Profile Form Hooks" as Hook
participant "User Store" as Store
end box

box "Gateway And Backend" #FFF4E5
participant "API Gateway" as Gateway
participant "Profile Controller" as ProfileSvc
participant "Auth Controller" as AuthSvc
end box

box "Database & Storage" #E8F5E9
participant "S3 Cloud Storage" as S3
participant "Database" as DB
end box

group Initialization & Form Hydration
  User -> Screen : open account settings page
  Screen -> Gateway : GET /api/User/auth/me
  Gateway -> ProfileSvc : getMe()
  ProfileSvc -> DB : read user profile row
  DB --> ProfileSvc : profile data
  ProfileSvc --> Gateway : profile payload (avatarPresignedUrl, meAiCoin, fullName, phoneNumber, address, birthday)
  Gateway --> Screen : hydrated payload
  Screen -> Screen : normalize phone formatting (adds +84 country code filter)
  Screen -> Screen : prefill personal details and set default dirtyFields ref
end

group Update Personal Information
  User -> Screen : modify Full Name, Phone, Address or select Birthday
  Screen -> Screen : check form dirty state & compare changes against original ref values
  alt form values contain edits
    Screen -> Screen : set hasChanges = true, enable "Save Changes" button
  end
  User -> Screen : click "Save Changes" button
  Screen -> Hook : validate inputs via zodResolver using UpdateProfileFormSchema
  alt validation check fails
    Hook --> Screen : render validation messages under invalid fields
  else validation succeeds
    Hook -> Gateway : PUT /api/User/auth/profile (fullName, phoneNumber, address, birthday)
    Gateway -> ProfileSvc : updateProfile
    ProfileSvc -> DB : save changed columns to users table
    DB --> ProfileSvc : profile saved
    ProfileSvc --> Gateway : updated profile details
    Gateway --> Hook : success response
    Hook -> Store : void refetchUser() to sync profile state across app
    Store --> Screen : show saved success toast & update visible profile header
  end
end

group Change Profile Avatar
  User -> Screen : click "Change avatar" button
  Screen -> Screen : trigger click on hidden file input tag
  User -> Screen : pick PNG or JPEG image file (capped at 15MB)
  
  alt selected file has illegal extension or size > 15MB
    Screen --> User : show error toast ("Only PNG/JPG/JPEG allowed, Max 15MB")
  else file is valid
    Screen -> Hook : trigger uploadAvatarMutation(file)
    Hook -> Gateway : PUT /api/User/profile/avatar (multipart formData)
    Gateway -> ProfileSvc : uploadAvatar
    ProfileSvc -> S3 : upload file binary & generate new presigned CDN URL
    S3 --> ProfileSvc : avatarPresignedUrl
    ProfileSvc -> DB : update avatar url in users table
    DB --> ProfileSvc : updated
    ProfileSvc --> Gateway : upload success
    Gateway --> Hook : upload success response
    Hook -> Store : void refetchUser() to refresh avatar CDN image
    Store --> Screen : show upload success toast & render new avatar image in settings
  end
end

group Change Password
  User -> Screen : type current password & new password inputs
  Screen -> Screen : toggles password eye icon to show/hide text characters
  User -> Screen : click "Update Password" button
  Screen -> Hook : validate oldPassword/newPassword matching criteria via zodResolver using ChangePasswordFormSchema
  alt passwords constraints fail
    Hook --> Screen : render password constraint message
  else validation succeeds
    Hook -> Gateway : POST /api/User/auth/change-password (oldPassword, newPassword)
    Gateway -> AuthSvc : changePassword
    AuthSvc -> DB : verify old password hash, write new encrypted hash
    alt old password is incorrect
      DB --> AuthSvc : verification failure
      AuthSvc --> Gateway : 400 Bad Request error
      Gateway --> Hook : error response
      Hook --> Screen : show error toast ("Current password is incorrect")
    else hash updated
      DB --> AuthSvc : success
      AuthSvc --> Gateway : password updated success
      Gateway --> Hook : success response
      Hook -> Screen : clear password inputs, reset form state, and show success toast
    end
  end
end
@enduml
