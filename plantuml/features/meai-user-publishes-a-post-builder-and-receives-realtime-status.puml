@startuml
title User Publishes Or Unpublishes A Draft And The Frontend Tracks Every Target In Real Time
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "Frontend Publishing Dialog" {
class "DialogPublishPost Component" as FE1 <<Frontend>> {
  +selectedAccounts: Record<string, string[]>
  +publishType: 'now' | 'schedule'
  +scheduleDate: Date
  +scheduleTime: string (HH:MM)
  +isPublishing: boolean
  +toggleAccount(platform: string, accountId: string)
  +buildScheduledAtUtc(): string | null
  +hasValidSelection: boolean
  +canSubmit: boolean
  +handleSubmit()
}
class "PostBuilderHeader Actions" as FE2 <<Frontend>> {
  +payloads: PublishPayload[]
  +canPublish: boolean
  +isPublishDisabled: boolean
  +handlePublish()
}
class "Notification Hub Connection" as FE3 <<Frontend>> {
  +NotificationReceived event
  +invalidateQueries(queryKey)
}
}

package "Backend Publishing Services" {
class "Post Controller" as BE1 <<Backend>> {
  +createPost(payload: CreatePostPayload)
  +publishPost(payload: PublishPayload)
  +schedulePost(postId: string, payload: SchedulePayload)
  +unpublishPost(postId: string)
}
class "Social Media API Gateway" as BE2 <<Backend>> {
  +fetchSocialMedias()
}
class "Publish Worker Consumer" as BE3 <<Backend>> {
  +processPublishQueue()
  +executeTargetPublish()
}
}

package "External Social Platforms & Bus" {
class "Social Media Graph APIs" as INT1 <<Integration>> {
  +Facebook Graph API
  +Instagram Graph API
  +TikTok Share API (Private mode)
  +Threads API
}
class "RabbitMQ & SignalR Bus" as INT2 <<Integration>> {
  +publishQueue: Exchange
  +SignalR Hub
}
}

FE2 --> FE1
FE1 --> BE2
FE1 --> BE1
BE1 --> BE3
BE3 --> INT2
INT2 --> FE3
BE3 --> INT1
@enduml

@startuml
title User Publishes Or Unpublishes A Draft And The Frontend Tracks Every Target In Real Time
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center

actor User
box "Frontend Publishing Workspace" #E8F0FE
participant "PostBuilder Header" as Header
participant "DialogPublishPost Modal" as Modal
participant "MediaResource Store" as Store
participant "Notification Listener" as SignalR
end box

box "Gateway And Backend" #FFF4E5
participant "API Gateway" as Gateway
participant "SocialMedia Service" as SocialSvc
participant "Post Service" as PostSvc
participant "Publish Worker" as Worker
end box

box "Message Bus & Social APIs" #E8F5E9
participant "RabbitMQ Bus" as Bus
participant "SignalR Service" as Hub
participant "Social Graph APIs" as SocialAPI
end box

group Open Publish Dialog & Hydrate Accounts
  User -> Header : click "Publish" button
  Header -> Modal : open DialogPublishPost modal (isOpen = true)
  Modal -> Gateway : GET /api/social-medias (fetchSocialMedias)
  Gateway -> SocialSvc : list connected social accounts
  SocialSvc --> Gateway : connected accounts list
  Gateway --> Modal : accounts payload
  Modal -> Modal : groupAccountsByPlatform (Facebook, Instagram, TikTok, Threads)
  Modal -> Modal : getPublishedAccountIdSet (identify already-published target accounts)
  Modal --> User : render platform group boxes, disable checkboxes for already published targets
end

group Form Controls: Account Toggle, Now vs Schedule Selector
  group Select Target Accounts
    User -> Modal : toggle account checkboxes
    Modal -> Modal : toggleAccount(platform, accountId)
    Modal -> Modal : update selectedAccounts list & check hasValidSelection
  end

  group Toggle Publish Type Selector
    User -> Modal : select "Now" radio button
    Modal -> Modal : clear scheduleDate & scheduleTime states
    
    User -> Modal : select "Schedule" radio button
    Modal -> Modal : auto-fill scheduleDate to Today & scheduleTime to Now + 5 minutes
    
    User -> Modal : adjust DatePickerInput & Time input
    Modal -> Modal : calculate combined schedule timestamp
    alt combined timestamp < now + 5 minutes
      Modal -> Modal : mark hasValidSelection = false, disable Submit button
    else timestamp is valid
      Modal -> Modal : mark hasValidSelection = true, enable Submit button
    end
  end
end

group Submit Publishing & Preflight Guard Checks
  User -> Modal : click "Publish / Schedule" confirm button
  Modal -> Modal : set isPublishing = true
  
  group Preflight Mixed-Media Check
    Modal -> Store : get active mediaResourceTypes for Facebook/Instagram
    alt active platform is Facebook/Instagram AND mode is Post
      alt selected media contains both images and a video (Mixed-Media)
        Modal -> Modal : reject submission
        Modal --> User : show error toast ("Facebook/Instagram post can't mix images and a video")
        Modal -> Modal : set isPublishing = false
      end
    end
  end

  loop For each selected platform payload
    opt Child Post does not exist yet (Draft Post creation)
      Modal -> Gateway : POST /api/posts (createPostPayload: draft status, content, platform, postBuilderId)
      Gateway -> PostSvc : createPost
      PostSvc -> DB : save draft post
      DB --> PostSvc : saved
      PostSvc --> Gateway : post created response (postId)
      Gateway --> Modal : postId
    end

    alt publishType is "schedule"
      Modal -> Modal : buildScheduledAtUtc() timestamp
      Modal -> Gateway : POST /api/posts/{postId}/schedule (scheduledAtUtc, selected socialMediaIds, isPrivate: TikTok = true)
      Gateway -> PostSvc : schedulePost(postId, payload)
      PostSvc -> DB : save schedule records, mark post status "scheduled"
      DB --> PostSvc : scheduled
      PostSvc --> Gateway : schedule success
      Gateway --> Modal : schedule success response
    else publishType is "now"
      Modal -> Gateway : POST /api/posts/publish (postId, selected socialMediaIds, isPrivate: TikTok = true, publishToMeAiFeed: Threads = true)
      Gateway -> PostSvc : publishPost
      PostSvc -> DB : update post status to "publishing"
      PostSvc -> Bus : enqueue publish-to-target task in RabbitMQ queue
      Bus --> PostSvc : enqueued
      PostSvc --> Gateway : 202 accepted
      Gateway --> Modal : publish accepted response
    end
  end

  Modal -> Modal : set isPublishing = false
  Modal -> Header : close modal, invalidate queries, redirect to /user/product
end

group Async Background Worker Processing & SignalR Live Feed
  Worker -> Bus : consume publish-to-target task
  Worker -> SocialSvc : load account access tokens & media file links
  SocialSvc --> Worker : tokens & credentials
  
  alt target platform is TikTok
    Worker -> SocialAPI : post media to TikTok Share API with isPrivate = true
  else target platform is Threads
    Worker -> SocialAPI : post to Threads Graph API
    opt publishToMeAiFeed is true
      Worker -> DB : mirror publication record to MeAI community social feed table
    end
  else target platform is Facebook/Instagram
    Worker -> SocialAPI : post image/video parameters to Meta Graph API
  end
  SocialAPI --> Worker : API publish success/failure response
  
  alt publish succeeded
    Worker -> DB : update publication status to "published", set published timestamp
    Worker -> Hub : push SignalR 'ai.publishing_schedule.completed' notification event
  else publish failed
    Worker -> DB : update publication status to "failed", save platform error log
    Worker -> Hub : push SignalR 'ai.publishing_schedule.failed' notification event
  end
  
  Hub --> SignalR : SignalR push notification event received in browser
  SignalR -> Gateway : GET updated post-builder status & query refresh
  Gateway --> SignalR : refreshed status payload
  SignalR -> Layout : update visible status banners, active badges & show completion toast
end

group Unpublish Flow
  User -> Layout : click "Unpublish" on a published post item
  Layout --> User : prompt confirm modal DialogConfirmUnpublish
  User -> Layout : confirm unpublish
  Layout -> Gateway : POST /api/posts/{postId}/unpublish
  Gateway -> PostSvc : unpublishPost
  PostSvc -> Bus : enqueue unpublish task in RabbitMQ
  Bus -> Worker : deliver unpublish work
  Worker -> SocialAPI : delete publication from Social Platform Graph APIs
  SocialAPI --> Worker : deleted success
  Worker -> DB : update publication status to "draft"
  Worker -> Hub : push SignalR update notification event
  Hub --> SignalR : refresh posts query cache in browser
  SignalR -> Layout : unlock editor input, show draft badge again
end
@enduml
